{
  "name": "UpMee - Instant Share",
  "short_name": "UpMee",
  "description": "Share text, links, and files across devices instantly.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#fdf2f8",
  "theme_color": "#fce7f3",
  "orientation": "any",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Message / Link",
      "short_name": "Paste",
      "description": "Paste message or link",
      "url": "/?action=paste",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Upload File",
      "short_name": "File",
      "description": "Upload a file",
      "url": "/?action=file",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
